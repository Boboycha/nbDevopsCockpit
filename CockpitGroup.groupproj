<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{CD210ECB-B844-43C7-8AFC-C5B67E4D4E41}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="..\UniListView\packages\UniListViewRuntime.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="src\nbDevOpsCockpit.dproj">
            <Dependencies>UniListViewRuntime</Dependencies>
        </Projects>
        <Projects Include="demo\nbDevOpsCockpitDemo.dproj">
            <Dependencies>nbDevOpsCockpit</Dependencies>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="UniListViewRuntime">
        <MSBuild Projects="..\UniListView\packages\UniListViewRuntime.dproj"/>
    </Target>
    <Target Name="UniListViewRuntime:Clean">
        <MSBuild Projects="..\UniListView\packages\UniListViewRuntime.dproj" Targets="Clean"/>
    </Target>
    <Target Name="UniListViewRuntime:Make">
        <MSBuild Projects="..\UniListView\packages\UniListViewRuntime.dproj" Targets="Make"/>
    </Target>
    <Target Name="nbDevOpsCockpit">
        <MSBuild Projects="src\nbDevOpsCockpit.dproj"/>
    </Target>
    <Target Name="nbDevOpsCockpit:Clean">
        <MSBuild Projects="src\nbDevOpsCockpit.dproj" Targets="Clean"/>
    </Target>
    <Target Name="nbDevOpsCockpit:Make">
        <MSBuild Projects="src\nbDevOpsCockpit.dproj" Targets="Make"/>
    </Target>
    <Target Name="nbDevOpsCockpitDemo">
        <MSBuild Projects="demo\nbDevOpsCockpitDemo.dproj"/>
    </Target>
    <Target Name="nbDevOpsCockpitDemo:Clean">
        <MSBuild Projects="demo\nbDevOpsCockpitDemo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="nbDevOpsCockpitDemo:Make">
        <MSBuild Projects="demo\nbDevOpsCockpitDemo.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="UniListViewRuntime;nbDevOpsCockpit;nbDevOpsCockpitDemo"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="nbDevOpsCockpitDemo:Clean;nbDevOpsCockpit:Clean;UniListViewRuntime:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="UniListViewRuntime:Make;nbDevOpsCockpit:Make;nbDevOpsCockpitDemo:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
