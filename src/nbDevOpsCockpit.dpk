package nbDevOpsCockpit;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'nb DevOps Cockpit - components for DevOps tooling (SSH, GitLab, etc.)'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  fmx,
  DesignIDE;

contains
  nbSSH.LibSSH2 in 'nbSSH.LibSSH2.pas',
  nbSSH.KeyValidation in 'nbSSH.KeyValidation.pas',
  nbFileSources in 'nbFileSources.pas',
  nbVectorIcons in 'nbVectorIcons.pas',
  nbFilePane.Controls in 'nbFilePane.Controls.pas',
  nbSFTPClient in 'nbSFTPClient.pas',
  nbSFTPTransfer in 'nbSFTPTransfer.pas',
  nbFilePane in 'nbFilePane.pas',
  ModernSSHClient in 'ModernSSHClient.pas',
  Terminal.Types in 'Terminal.Types.pas',
  Terminal.Theme in 'Terminal.Theme.pas',
  Terminal.Buffer in 'Terminal.Buffer.pas',
  Terminal.AnsiParser in 'Terminal.AnsiParser.pas',
  Terminal.Renderer in 'Terminal.Renderer.pas',
  Terminal.Input in 'Terminal.Input.pas',
  Terminal.Clipboard in 'Terminal.Clipboard.pas',
  Terminal.SSHBridge in 'Terminal.SSHBridge.pas',
  Terminal.Control in 'Terminal.Control.pas',
  nbTextDocument in 'nbTextDocument.pas',
  nbCodeEditor in 'nbCodeEditor.pas',
  FMX.StyledContextMenu in '..\third_party\FMXRichMemo\FMX.StyledContextMenu.pas',
  Syntax.Code in '..\third_party\FMXRichMemo\Syntax.Code.pas',
  Syntax.Code.Pascal in '..\third_party\FMXRichMemo\Syntax.Code.Pascal.pas',
  Syntax.Code.JSON in '..\third_party\FMXRichMemo\Syntax.Code.JSON.pas',
  Syntax.Code.SQL in '..\third_party\FMXRichMemo\Syntax.Code.SQL.pas',
  Syntax.Code.Python in '..\third_party\FMXRichMemo\Syntax.Code.Python.pas',
  Syntax.Code.HTML in '..\third_party\FMXRichMemo\Syntax.Code.HTML.pas',
  Syntax.Code.CSS in '..\third_party\FMXRichMemo\Syntax.Code.CSS.pas',
  Syntax.Code.MarkDown in '..\third_party\FMXRichMemo\Syntax.Code.MarkDown.pas',
  Syntax.Code.Shell in '..\third_party\FMXRichMemo\Syntax.Code.Shell.pas',
  FMX.RichEdit.Style in '..\third_party\FMXRichMemo\FMX.RichEdit.Style.pas',
  GoghThemeLoader in 'GoghThemeLoader.pas',
  Reg_nbDevOpsCockpit in 'Reg_nbDevOpsCockpit.pas';

(*По мере роста добавлять сюда новые юниты:
     - GitLab.Client
     - Servers.Inventory
     - Snippets.Runner
     - Audit.Logger
     ... *)

end.
